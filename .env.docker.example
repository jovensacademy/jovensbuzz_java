# =============================================================
# Jovens Buzz API — Docker / VPS configuration
# Copy to backend/.env.docker (git-ignored), fill in every CHANGE_ME, then:
#   chmod 600 .env.docker
#   docker compose --env-file .env.docker up -d --build
# Used by docker-compose.yml only. backend/.env stays the local XAMPP config.
# Never commit .env.docker. Values are read literally (no quotes needed).
# =============================================================

# ---------- Database (the stack's own MySQL container) ----------
DB_NAME=jovens_buzz
DB_USERNAME=jovens_buzz_app
# Long random values, e.g.: openssl rand -base64 33
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
# Traffic stays inside the private Docker network
DB_USE_SSL=false
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true
DB_TIMEZONE=UTC
DB_CHARACTER_ENCODING=UTF-8

# ---------- Security ----------
# Refuses to start with the default JWT secret or the documented dev password
APP_PRODUCTION_MODE=true
# Base64, at least 32 random bytes: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION_MS=3600000
SWAGGER_ENABLED=false
# Host-side gateway of jovens-buzz-network (requests from Nginx / Next.js on the host arrive from here),
# so the rate limiter reads the real visitor IP from X-Forwarded-For
TRUSTED_PROXIES=172.29.82.1

# First admin, created only while the admin_users table is empty. Use a strong unique password,
# sign in, change it, then you may blank these two values.
BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME
BOOTSTRAP_ADMIN_NAME=Jovens Buzz Admin

# ---------- Public URLs / CORS ----------
# Exact site origins, comma-separated, no trailing slash
CORS_ALLOWED_ORIGINS=https://jovensbuzz.com,https://www.jovensbuzz.com
PUBLIC_SITE_URL=https://jovensbuzz.com
ADMIN_DASHBOARD_URL=https://jovensbuzz.com/admin
BUSINESS_TIMEZONE=America/Chicago

# ---------- Google Sheets (Apps Script web app) ----------
GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_SHEETS_SECRET_TOKEN=CHANGE_ME
GOOGLE_SHEETS_SPREADSHEET_ID=CHANGE_ME
GOOGLE_SHEETS_SPREADSHEET_NAME=jovens_Buzz_website
GOOGLE_SHEETS_WORKSHEET_NAME=Enquiries

# ---------- SMTP ----------
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
# Gmail: a 16-character App Password
SMTP_PASSWORD=CHANGE_ME
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true
SMTP_FROM_EMAIL=CHANGE_ME
SMTP_FROM_NAME=Jovens Buzz
ADMIN_NOTIFICATION_EMAIL=CHANGE_ME
CLIENT_SUPPORT_EMAIL=
CLIENT_RESPONSE_TIME=24 hours

# ---------- Optional ----------
# LOGGING_LEVEL_COM_JOVENSBUZZ=INFO
# RATE_LIMIT_ENQUIRY_MAX=5
# BACKEND_BIND_ADDRESS=127.0.0.1   (compose-level: set 0.0.0.0 only if no reverse proxy)
